      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/enriconannivicenzi/Desktop/AppBackupFoto/.claude/hooks/protect_log_dir.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
